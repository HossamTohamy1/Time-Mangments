<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Timetable.Api</RootNamespace>
    <UserSecretsId>timetable-api-3f0c1b7e</UserSecretsId>
    <!-- Relative path to the standalone Angular workspace. -->
    <ClientRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', 'frontend'))</ClientRoot>
    <SkipClientBuild Condition="'$(SkipClientBuild)' == ''">false</SkipClientBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Timetable.Application\Timetable.Application.csproj" />
    <ProjectReference Include="..\Timetable.Infrastructure\Timetable.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Timetable.Api.IntegrationTests" />
  </ItemGroup>

  <!--
    Builds the Angular client into wwwroot before publishing so `dotnet publish` yields a complete app.
    Skip with: dotnet publish -p:SkipClientBuild=true
  -->
  <Target Name="BuildAngularClient" BeforeTargets="ComputeFilesToPublish;PrepareForPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Message Importance="high" Text="Building Angular client in $(ClientRoot) ..." />
    <Exec Command="npm ci" WorkingDirectory="$(ClientRoot)" />
    <Exec Command="npm run build:prod" WorkingDirectory="$(ClientRoot)" />
    <ItemGroup>
      <_ClientDist Include="wwwroot\**" Exclude="wwwroot\.gitkeep" />
      <ResolvedFileToPublish Include="@(_ClientDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(_ClientDist.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
