{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "timetable",
    "Audience": "timetable-web",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "SigningKey": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Storage": {
    "Root": "App_Data"
  },
  "Solver": {
    "DefaultTimeLimitSeconds": 60,
    "DefaultWorkers": 4,
    "HeuristicThresholdSessions": 0
  },
  "Localization": {
    "DefaultCulture": "en",
    "SupportedCultures": [ "en", "ar" ]
  }
}
